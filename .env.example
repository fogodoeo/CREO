BAND_OAUTH_CLIENT_ID=
BAND_OAUTH_CLIENT_SECRET=
BAND_OAUTH_SESSION_SECRET=
BAND_OAUTH_PUBLIC_URL=https://creok.onrender.com
BAND_OAUTH_REDIRECT_URI=https://creok.onrender.com/api/band-oauth/callback
BAND_OAUTH_RETURN_URL=https://creok.onrender.com/crewart-survey.html
BAND_OAUTH_ALLOWED_RETURN_URLS=https://cdcup.onrender.com/crewart-survey.html
BAND_OAUTH_TARGET_BAND_NO=101878670
BAND_OAUTH_TARGET_BAND_KEY=
BAND_OAUTH_TARGET_BAND_URL=https://www.band.us/band/101878670/post
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BAND_MEMBER_SESSION_SECRET=
BAND_MEMBER_TABLE=band_members
BAND_MEMBER_PHONE_COLUMN=phone_normalized
BAND_MEMBER_ACTIVE_COLUMN=is_active
BAND_MEMBER_KEY_COLUMN=band_member_key
BAND_MEMBER_NAME_COLUMN=display_name
BAND_MEMBER_TARGET_BAND_URL=https://www.band.us/band/101878670/post
BAND_MEMBER_SESSION_TTL_SEC=7200
# 로컬 테스트에서만 0으로 제한을 끌 수 있습니다. Render/production에서는 최소 제한이 적용됩니다.
BAND_MEMBER_RATE_LIMIT_ATTEMPTS=8
BAND_MEMBER_RATE_LIMIT_WINDOW_MS=600000
# 필수: 배포 환경에서 길고 임의적인 관리자 비밀번호를 설정하세요. 소스 기본값은 없습니다.
CREO_ADMIN_SECRET=
CREO_DATA_SIGNING_SECRET=
CREO_PLATFORM_STORAGE=sqlite
# Render Persistent Disk 마운트 경로 아래만 재배포 후에도 보존됩니다.
CREO_DATA_DIR=/var/data/creo-platform
CREO_SUPABASE_MIRROR_ENABLED=true
CREO_CAPTURE_BUCKET=auction-captures
# 선택 사항: 별도 캡처 토큰. 비우면 CREO_ADMIN_SECRET으로도 에이전트 인증이 가능합니다.
CREO_CAPTURE_AGENT_TOKEN=

# 낙찰·배송 정산표를 사용자의 Google Drive에 새 시트로 생성합니다.
# Google Cloud OAuth 2.0 웹 클라이언트 ID이며 비밀키가 아닙니다.
GOOGLE_OAUTH_CLIENT_ID=

# BAND 가입 승인 모니터. 로그인 쿠키는 Git/채팅이 아니라 Render Secret에만 저장합니다.
BAND_MONITOR_ENABLED=false
BAND_CHROME_HEADLESS=true
BAND_START_URL=https://www.band.us/band/101878670/applications
BAND_CHROME_PROFILE_DIR=/var/data/band-monitor/chrome-profile
BAND_MONITOR_STATE_FILE=/var/data/band-monitor/state.json
BAND_MONITOR_LOG_FILE=/var/data/band-monitor/monitor.log
BAND_MONITOR_STATUS_FILE=/var/data/band-monitor/runtime.json
BAND_MEMBER_SYNC_ENABLED=true
BAND_MEMBER_SYNC_INTERVAL_SECONDS=300
BAND_MEMBER_RECONCILE_ENABLED=true
BAND_MEMBER_RECONCILE_INTERVAL_SECONDS=60
BAND_COOKIE_JSON=
BAND_COOKIE_HEADER=
BAND_CHROME_USER_AGENT=

# 낙찰·배송·결제 알리고 문자/알림톡. 비밀값은 Render Secret에만 저장합니다.
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_FROM_NUMBER=
ALIGO_KAKAO_SENDER_KEY=
ALIGO_TEST_MODE=Y
ALIGO_KAKAO_TEMPLATE_CODES_JSON={}
ALIGO_KAKAO_TEMPLATE_CONTENTS_JSON={}
# 구매자 페이지를 별도 정적 호스트로 분리할 때만 지정합니다.
CREO_BUYER_SITE_ORIGIN=
